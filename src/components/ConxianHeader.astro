---
import Search from '@astrojs/starlight/components/Search.astro';
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
---
<div class="cx-global-header">
  <a class="cx-brand" href="/" aria-label="Conxian home">
    <span class="cx-brand-mark" aria-hidden="true"><span>C</span></span>
    <span class="cx-brand-wordmark"><strong>CONXIAN</strong><small>THE SOVEREIGN ECOSYSTEM</small></span>
  </a>
  <nav class="cx-primary-nav" aria-label="Primary navigation">
    <a href="/#principles">Vision</a>
    <a href="/#ecosystem">Ecosystem</a>
    <a href="/guides/getting-started/">Developers</a>
    <a href="/ecosystem/status/">Transparency</a>
    <a href="https://github.com/Conxian">Community</a>
  </nav>
  <div class="cx-header-actions">
    <div class="cx-header-search"><Search /></div>
    <a class="cx-header-cta" href={isHome ? '/guides/getting-started/' : '/'}>{isHome ? 'Start building' : 'Explore Conxian'} <span aria-hidden="true">↗</span></a>
    <details class="cx-mobile-nav">
      <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
      <nav aria-label="Mobile navigation">
        <a href="/#principles">Vision</a>
        <a href="/#ecosystem">Ecosystem</a>
        <a href="/guides/getting-started/">Developers</a>
        <a href="/ecosystem/status/">Transparency</a>
        <a href="https://github.com/Conxian">Community</a>
        <a href="https://www.conxian-labs.com/">Conxian Labs ↗</a>
      </nav>
    </details>
  </div>
</div>
<style>
  .cx-global-header { width: 100%; height: 100%; min-height: 0; display: flex; align-items: center; justify-content: space-between; gap: clamp(.7rem,2vw,2rem); padding: 0 clamp(1rem,3.7vw,4rem); border-bottom: 1px solid rgba(210,172,101,.19); background: rgba(16,20,22,.97); color: #f3eee3; }
  .cx-brand { display: inline-flex; align-items: center; gap: .8rem; min-width: 0; text-decoration: none; color: #f3eee3; }
  .cx-brand-mark { display: grid; place-items: center; width: 42px; height: 42px; flex-shrink: 0; border: 1px solid #caa362; background: radial-gradient(circle at 28% 20%, #2d3432,#101416 75%); transform: rotate(45deg); border-radius: 8px; }
  .cx-brand-mark span { font-family: Georgia,serif; font-size: 1.7rem; color: #e0bd7c; transform: rotate(-45deg); }
  .cx-brand-wordmark { display: flex; flex-direction: column; gap: 4px; line-height: 1; }
  .cx-brand-wordmark strong { font-size: 1rem; letter-spacing: .2em; font-weight: 800; }
  .cx-brand-wordmark small { font-size: .52rem; letter-spacing: .12em; color: #c8b78e; white-space: nowrap; }
  .cx-primary-nav { display: flex; gap: clamp(.8rem,2vw,2rem); align-items: center; justify-content: center; }
  .cx-primary-nav a { color: #d5d4ce; text-decoration: none; font-size: .81rem; font-weight: 600; white-space: nowrap; transition: color .2s; }
  .cx-primary-nav a:hover { color: #e0bd7c; }
  .cx-header-actions { display: flex; gap: .9rem; align-items: center; }
  .cx-header-search { max-width: 190px; }
  .cx-header-cta { display: inline-flex; align-items: center; gap: 1.1rem; border: 1px solid #d2ac65; background: #d2ac65; padding: .72rem 1rem; color: #121617; font-weight: 750; font-size: .78rem; text-decoration: none; border-radius: 2px; white-space: nowrap; }
  .cx-header-cta:hover { background: #edc785; }
  .cx-global-header a:focus-visible, .cx-global-header summary:focus-visible { outline: 3px solid #f5cc73; outline-offset: 4px; }
  .cx-mobile-nav { display: none; position: relative; }
  .cx-mobile-nav summary { width: 42px; height: 42px; border: 1px solid rgba(210,172,101,.35); border-radius: 2px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; cursor: pointer; list-style: none; }
  .cx-mobile-nav summary::-webkit-details-marker { display:none; }
  .cx-mobile-nav summary span { width: 19px; height: 1.5px; background: #e8d0a3; }
  .cx-mobile-nav nav { position: absolute; right: 0; top: calc(100% + 15px); z-index: 100; width: min(80vw,310px); display: flex; flex-direction: column; border: 1px solid rgba(210,172,101,.35); background: #1b2021; box-shadow: 0 18px 50px #0009; padding: .5rem; }
  .cx-mobile-nav nav a { color: #eee8dc; text-decoration: none; padding: 1rem; border-bottom: 1px solid rgba(210,172,101,.12); }
  .cx-mobile-nav nav a:hover { background: rgba(210,172,101,.09); }
  @media(max-width: 1130px) { .cx-primary-nav { gap: .9rem; }.cx-primary-nav a {font-size: .75rem}.cx-header-search {max-width:140px} }
  @media(max-width: 1100px) { .cx-primary-nav { display: none; } .cx-mobile-nav { display: block; } }
  @media(max-width: 560px) { .cx-global-header { min-height: 70px; padding-inline: 1rem; } .cx-brand-mark {width:36px;height:36px}.cx-brand-wordmark strong {font-size:.85rem}.cx-brand-wordmark small {font-size:.43rem}.cx-header-cta { display:none; }.cx-header-search { max-width: 90px; } }
  @media(prefers-reduced-motion: reduce) { .cx-global-header * {transition: none !important} }
</style>